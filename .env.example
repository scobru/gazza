# gazza — every setting, and what it is for.
#
# Nothing here is required: the defaults are the safe posture. Copy this to
# .env for docker compose, or paste the lines you want into your platform's
# environment variables. .env is gitignored; this file is not, so keep secrets
# out of it.

# ----------------------------------------------------------------- network
# Loopback on a workstation, every interface inside a container, decided at
# startup. Set this only to override that.
# HOST=0.0.0.0
# PORT=4321

# ------------------------------------------------------------------ limits
# How big a file may be handed to her.
#
# This is the setting that matters, because the video is roughly 190 times the
# file and every frame costs x264 time. On the YouTube profile:
#
#     256 KB  ->    23 s of video,    49 MB of mp4,    700 frames
#     512 KB  ->    46 s,             98 MB,          1392 frames
#       1 MB  ->    93 s,            196 MB,          2784 frames
#       8 MB  ->   741 s,           1565 MB,         22240 frames   (the default)
#
# 8 MB is fine on your own machine and far too generous on an instance
# strangers can reach: one request would hold the encoder for minutes and write
# a gigabyte and a half. Around 256 KB is a sensible public ceiling.
# GAZZA_MAX_FILE=262144

# How big a carrier may be on the way back in. This is currently buffered in
# memory while it uploads, so treat it as RAM you are prepared to lose to a
# single request.
# GAZZA_MAX_VIDEO=67108864

# Requests allowed to wait for the encoder. Only one encode runs at a time —
# ffmpeg is CPU-bound and running several does not finish them sooner — so a
# long queue only produces long waits. Past this, callers are turned away.
# GAZZA_MAX_QUEUE=2

# Carriers are deleted when collected, but nobody has to collect them. Anything
# older than this is swept, whether it was picked up or not.
# GAZZA_JOB_TTL_MS=900000

# ----------------------------------------------------------------- fetching
# Whether she may fetch a link herself.
#
# Leave this off unless you mean it. A link means this server makes a request
# chosen by whoever called it, and from inside a container that reaches things
# you did not intend: sibling apps by name, the provider's metadata endpoint,
# anything on the private network. With it off people upload the video file
# instead, which costs them one step and costs you nothing.
# GAZZA_ALLOW_URLS=1

# Where a link may point, when the above is on. Matched on a dot boundary, so
# evil-youtube.com does not pass as youtube.com.
# GAZZA_URL_HOSTS=youtube.com,youtu.be,instagram.com

# ------------------------------------------------------------------- access
# A shared secret, sent as the x-gazza-token header or a ?token= parameter.
# Unset means the instance is open to anyone who can reach it. Set it if you
# want gazza somewhere public but used only by you.
#
# Do not put the real value in this file — it is committed. Put it in your
# platform's environment variables, or in .env, which is not.
# GAZZA_TOKEN=

# ---------------------------------------------------------------- passwords
# For scripting the command line, so the password is not typed at a prompt.
# The server never needs it: it takes the password per request, in a header.
# GAZZA_PASSWORD=
